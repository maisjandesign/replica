{
  "manifest_version": 3,
  "name": "Codex Capture",
  "version": "0.1.0",
  "description": "Select a section on any page and turn it into an implementation prompt for Codex.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Codex Capture",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
